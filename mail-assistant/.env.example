########################################################################
# Script Properties 設定例
#
# このファイルは **設定値の一覧と既定値を示すためのもの**。
# 実際の設定は Apps Script エディタの
#   プロジェクトの設定 → スクリプト プロパティ
# に「キー / 値」として登録する（このファイルを GAS が読むことはない）。
#
# 秘密情報（GEMINI_API_KEY / CHAT_WEBHOOK_URL）は絶対にコミットしないこと。
# このファイルにも実際の値を書き込まないこと。
########################################################################

# ---------------------------------------------------------------- 対象
# 対象メールアドレス
TARGET_EMAIL=sato@sanrikutech.jp

# ------------------------------------------------------ 時刻・稼働条件
# タイムゾーン（DST の無いゾーンのみ対応: Asia/Tokyo, Asia/Seoul, Asia/Shanghai,
# Asia/Singapore, Asia/Kolkata, UTC）
TIMEZONE=Asia/Tokyo
# 稼働開始時刻（時。この時刻以降を処理する）
WORK_START_HOUR=8
# 稼働終了時刻（時。この時刻の直前まで処理する。区間は [開始, 終了)）
WORK_END_HOUR=18
# 実行間隔（分）。GAS の制約により 1 / 5 / 10 / 15 / 30 のいずれか
RUN_INTERVAL_MINUTES=10
# 平日のみ処理するか
WEEKDAYS_ONLY=true
# 日本の祝日を除外するか
SKIP_JP_HOLIDAYS=true
# 追加の休業日（YYYY-MM-DD のカンマ区切り。年末年始や特例日に使う）
EXTRA_HOLIDAYS=
# 稼働時間外に受信したメールも処理対象にするか
# false=8:00〜18:00 に受信したメールだけを対象にする（要件どおりの既定）
INCLUDE_OFF_HOURS_RECEIVED=false
# 未処理メールを遡る上限（時間）。連休明けの取りこぼし補完に効く
MAX_CATCHUP_HOURS=96
# 前回実行時刻から巻き戻して検索する余裕（分）。重複は履歴で排除される
CURSOR_OVERLAP_MINUTES=30

# -------------------------------------------------------- 過去メール分析
# 過去メールの検索期間（か月）
HISTORY_LOOKBACK_MONTHS=12
# 過去メールの最大取得件数（1通の返信を作るために参照する上限）
HISTORY_MAX_MESSAGES=30
# 同一スレッドから参照する最大メッセージ数
THREAD_MAX_MESSAGES=10
# AI へ渡す1メールあたりの最大文字数
BODY_MAX_CHARS=4000

# ------------------------------------------------------------------- AI
# Gemini API キー（必須・秘密）。https://aistudio.google.com/apikey
GEMINI_API_KEY=
# AIモデル名
GEMINI_MODEL=gemini-2.5-flash
# 思考トークン。2.5 系は 0 にしないと JSON が途中で切れる
GEMINI_THINKING_BUDGET=0
# この確信度以上で返信下書きを自動作成
CONFIDENCE_REPLY_THRESHOLD=0.85
# この確信度以上〜上記未満は「要確認」。これ未満は下書きを作らずログのみ
CONFIDENCE_REVIEW_THRESHOLD=0.60

# ---------------------------------------------------------------- 動作
# REVIEW_REQUIRED のとき確認用下書きを作るか
# false = AI要確認ラベルのみ / true = 先頭に【AI判定：要確認】を付けた下書きを作る
REVIEW_CREATES_DRAFT=false
# 返信の Cc の扱い
# none            = Cc を付けない（最も安全・既定）
# mirror-previous = 同一スレッドで佐藤自身が過去に Cc していた相手のみ引き継ぐ
CC_MODE=none
# 下書きに付ける署名。空にすると過去の送信メールから推定した署名を使う
SIGNATURE_TEXT=
# 重要メール判定のキーワード（返信不要でも履歴に記録する）
IMPORTANT_KEYWORDS=請求,契約,見積,支払,振込,入金,解約,納期,セキュリティ,invoice,contract,security,payment
# 返信不可・通知系と見なす送信者アドレスの部分文字列
NOTIFY_SENDER_PATTERNS=no-reply,noreply,do-not-reply,donotreply,notifications@,notification@,mailer-daemon,postmaster,bounce
# エラーになったメールを再試行する回数
RETRY_MAX=2

# --------------------------------------------------------------- ラベル
LABEL_DRAFT=AI返信下書き
LABEL_REVIEW=AI要確認
LABEL_NO_REPLY=AI返信不要
LABEL_DONE=AI処理済み
LABEL_ERROR=AI処理エラー
# 重要メールに付けるラベル。空ならラベルを付けずログのみ
LABEL_IMPORTANT=

# ---------------------------------------------------------- テスト・安全
# ドライラン。true の間は Gmail への下書き作成・ラベル付与を一切行わない
# 【重要】初期状態は true。人間が明示的に false にするまで本番動作しない
DRY_RUN=true
# テストモード。true にすると TEST_LABEL / TEST_SENDERS で対象を絞る
TEST_MODE=false
# テスト対象ラベル（このラベルが付いたメールだけを処理する）
TEST_LABEL=AIテスト対象
# テスト対象送信者（カンマ区切り。指定するとこのアドレスからのメールだけを処理する）
TEST_SENDERS=
# 1回の実行で処理する最大件数
MAX_MESSAGES_PER_RUN=20
# プレビューに生成した返信案を含めるか（受信メール本文は常に出力しない）
PREVIEW_INCLUDE_DRAFT=true

# --------------------------------------------------------- 履歴・通知
# 処理履歴を書くスプレッドシートの ID。
# 空にすると PropertiesService へ直近400件のみ保持するフォールバックになる
HISTORY_SHEET_ID=
# 日次集計を有効にするか
SUMMARY_ENABLED=true
# 集計の出力先。log = 実行ログのみ / chat = Google Chat Webhook
# （メール送信は実装していない）
SUMMARY_CHANNEL=log
# Google Chat の Webhook URL（SUMMARY_CHANNEL=chat のときのみ・秘密）
CHAT_WEBHOOK_URL=
